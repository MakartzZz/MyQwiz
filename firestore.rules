rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // INTERRUPTOR DE EMERGENCIA DE MYQWIZ
    //
    // Servicio abierto (estado normal):  return true;
    // Servicio cerrado (bloqueo total):  return false;
    //
    // Después de cambiar el valor, publica las reglas desde la carpeta del proyecto:
    // firebase deploy --only firestore:rules --project myqwiz-1df0f
    //
    // También puedes editar esta misma función en Firebase Console > Firestore > Reglas
    // y pulsar "Publicar". Para restaurar el servicio, vuelve a true y publica otra vez.
    // Este interruptor bloquea Firestore, pero no deshabilita Firebase Authentication.
    function serviceIsOpen() {
      return true;
    }

    function signedIn() {
      return serviceIsOpen() && request.auth != null;
    }

    function isSelf(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function validAvatarId(avatarId) {
      return avatarId is int && avatarId >= 1 && avatarId <= 15;
    }

    function validQuestionCount(questionCount) {
      return questionCount is int && questionCount >= 0 && questionCount <= 100;
    }

    function validQuestionTypeCounts(counts, questionCount) {
      return counts is map
        && counts.keys().hasAll([
          'multiple-choice', 'true-false', 'matching', 'fill-blank', 'short-answer'
        ])
        && counts.keys().hasOnly([
          'multiple-choice', 'true-false', 'matching', 'fill-blank', 'short-answer'
        ])
        && counts['multiple-choice'] is int
        && counts['true-false'] is int
        && counts.matching is int
        && counts['fill-blank'] is int
        && counts['short-answer'] is int
        && counts['multiple-choice'] >= 0
        && counts['true-false'] >= 0
        && counts.matching >= 0
        && counts['fill-blank'] >= 0
        && counts['short-answer'] >= 0
        && counts['multiple-choice']
          + counts['true-false']
          + counts.matching
          + counts['fill-blank']
          + counts['short-answer'] == questionCount;
    }

    function validQuizPreferences(preferences) {
      return preferences is map
        && preferences.keys().hasAll(['themeId', 'playlistId'])
        && preferences.keys().hasOnly(['themeId', 'playlistId'])
        && (preferences.themeId == null
          || (preferences.themeId is string && preferences.themeId.size() <= 60))
        && (preferences.playlistId == null
          || (preferences.playlistId is string && preferences.playlistId.size() <= 120));
    }

    function validQuizSettings(settings) {
      return settings is map
        && settings.keys().hasAll(['shuffleQuestions', 'shuffleAnswers'])
        && settings.keys().hasOnly(['shuffleQuestions', 'shuffleAnswers'])
        && settings.shuffleQuestions is bool
        && settings.shuffleAnswers is bool;
    }

    function validEntryChallenge(challenge) {
      return challenge is map
        && challenge.keys().hasAll([
          'version', 'questionId', 'answer', 'normalizedAnswer', 'distractors'
        ])
        && challenge.keys().hasOnly([
          'version', 'questionId', 'answer', 'normalizedAnswer', 'distractors'
        ])
        && challenge.version == 1
        && challenge.questionId in ['travel', 'food', 'free_time']
        && challenge.answer is string
        && challenge.answer.size() >= 2
        && challenge.answer.size() <= 60
        && challenge.normalizedAnswer is string
        && challenge.normalizedAnswer.size() >= 2
        && challenge.normalizedAnswer.size() <= 60
        && challenge.distractors is list
        && challenge.distractors.size() == 3
        && challenge.distractors[0] is string
        && challenge.distractors[0].size() >= 2
        && challenge.distractors[0].size() <= 60
        && challenge.distractors[1] is string
        && challenge.distractors[1].size() >= 2
        && challenge.distractors[1].size() <= 60
        && challenge.distractors[2] is string
        && challenge.distractors[2].size() >= 2
        && challenge.distractors[2].size() <= 60
        && challenge.answer != challenge.distractors[0]
        && challenge.answer != challenge.distractors[1]
        && challenge.answer != challenge.distractors[2]
        && challenge.distractors[0] != challenge.distractors[1]
        && challenge.distractors[0] != challenge.distractors[2]
        && challenge.distractors[1] != challenge.distractors[2];
    }

    function quizExists(quizId) {
      return exists(/databases/$(database)/documents/quizzes/$(quizId));
    }

    function ownsQuiz(quizId) {
      return signedIn()
        && quizExists(quizId)
        && get(/databases/$(database)/documents/quizzes/$(quizId)).data.ownerId == request.auth.uid;
    }

    function ownsQuizAfter(quizId) {
      return signedIn()
        && existsAfter(/databases/$(database)/documents/quizzes/$(quizId))
        && getAfter(/databases/$(database)/documents/quizzes/$(quizId)).data.ownerId == request.auth.uid;
    }

    function hasQuizShare(quizId) {
      return signedIn()
        && exists(/databases/$(database)/documents/quizShares/$(quizId + '_' + request.auth.uid));
    }

    function canReadQuiz(quizId) {
      return ownsQuiz(quizId) || hasQuizShare(quizId);
    }

    function validProfile(data, uid) {
      return data.keys().hasAll([
          'uid', 'username', 'normalizedUsername', 'tag', 'avatarId', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'uid', 'username', 'normalizedUsername', 'tag', 'avatarId', 'createdAt', 'updatedAt'
        ])
        && data.uid == uid
        && data.username is string
        && data.username.size() >= 2
        && data.username.size() <= 32
        && data.normalizedUsername is string
        && data.normalizedUsername.size() >= 2
        && data.normalizedUsername.size() <= 32
        && data.tag is string
        && data.tag.matches('^[2-9A-HJ-NP-Z]{6}$')
        && validAvatarId(data.avatarId)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    match /profiles/{uid} {
      allow read: if signedIn();

      allow create: if isSelf(uid)
        && validProfile(request.resource.data, uid)
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && existsAfter(/databases/$(database)/documents/userTags/$(request.resource.data.tag))
        && getAfter(/databases/$(database)/documents/userTags/$(request.resource.data.tag)).data.uid == uid;

      allow update: if isSelf(uid)
        && validProfile(request.resource.data, uid)
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.tag == resource.data.tag
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.updatedAt == request.time
        && existsAfter(/databases/$(database)/documents/userTags/$(request.resource.data.tag))
        && getAfter(/databases/$(database)/documents/userTags/$(request.resource.data.tag)).data.normalizedUsername
          == request.resource.data.normalizedUsername;

      allow delete: if false;
    }

    match /userTags/{tag} {
      allow read: if signedIn();

      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['uid', 'normalizedUsername', 'createdAt', 'updatedAt'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && existsAfter(/databases/$(database)/documents/profiles/$(request.auth.uid))
        && getAfter(/databases/$(database)/documents/profiles/$(request.auth.uid)).data.tag == tag
        && getAfter(/databases/$(database)/documents/profiles/$(request.auth.uid)).data.normalizedUsername
          == request.resource.data.normalizedUsername;

      allow update: if signedIn()
        && resource.data.uid == request.auth.uid
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.updatedAt == request.time
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['normalizedUsername', 'updatedAt'])
        && getAfter(/databases/$(database)/documents/profiles/$(request.auth.uid)).data.tag == tag
        && getAfter(/databases/$(database)/documents/profiles/$(request.auth.uid)).data.normalizedUsername
          == request.resource.data.normalizedUsername;

      allow delete: if false;
    }

    match /users/{uid} {
      function validPrivateUser(data) {
        return data.keys().hasAll([
            'uid', 'email', 'ownedQuizCount', 'lastQuizMutationId', 'entryChallenge',
            'createdAt', 'updatedAt'
          ])
          && data.keys().hasOnly([
            'uid', 'email', 'ownedQuizCount', 'lastQuizMutationId', 'entryChallenge',
            'createdAt', 'updatedAt'
          ])
          && data.uid == uid
          && data.email is string
          && data.ownedQuizCount is int
          && data.ownedQuizCount >= 0
          && data.ownedQuizCount <= 30
          && (data.lastQuizMutationId == null || data.lastQuizMutationId is string)
          && validEntryChallenge(data.entryChallenge)
          && data.createdAt is timestamp
          && data.updatedAt is timestamp;
      }

      function incrementsQuizCount() {
        let quizId = request.resource.data.lastQuizMutationId;
        return request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['ownedQuizCount', 'lastQuizMutationId', 'updatedAt'])
          && request.resource.data.ownedQuizCount == resource.data.ownedQuizCount + 1
          && request.resource.data.ownedQuizCount <= 30
          && quizId is string
          && !exists(/databases/$(database)/documents/quizzes/$(quizId))
          && ownsQuizAfter(quizId);
      }

      function decrementsQuizCount() {
        let quizId = request.resource.data.lastQuizMutationId;
        return request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['ownedQuizCount', 'lastQuizMutationId', 'updatedAt'])
          && request.resource.data.ownedQuizCount == resource.data.ownedQuizCount - 1
          && request.resource.data.ownedQuizCount >= 0
          && quizId is string
          && quizExists(quizId)
          && get(/databases/$(database)/documents/quizzes/$(quizId)).data.ownerId == uid
          && !existsAfter(/databases/$(database)/documents/quizzes/$(quizId));
      }

      function updatesEntryChallenge() {
        return request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['entryChallenge', 'updatedAt'])
          && validEntryChallenge(request.resource.data.entryChallenge);
      }

      allow read: if isSelf(uid);

      allow create: if isSelf(uid)
        && validPrivateUser(request.resource.data)
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.ownedQuizCount == 0
        && request.resource.data.lastQuizMutationId == null
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;

      allow update: if isSelf(uid)
        && validPrivateUser(request.resource.data)
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.email == resource.data.email
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.updatedAt == request.time
        && (incrementsQuizCount() || decrementsQuizCount() || updatesEntryChallenge());

      allow delete: if false;
    }

    match /quizzes/{quizId} {
      function validQuizSummary(data) {
        return data.keys().hasAll([
            'id', 'ownerId', 'schemaVersion', 'title', 'description', 'iconId',
            'questionCount', 'questionTypeCounts', 'preferences', 'settings', 'createdAt', 'updatedAt'
          ])
          && data.keys().hasOnly([
            'id', 'ownerId', 'schemaVersion', 'title', 'description', 'iconId',
            'questionCount', 'questionTypeCounts', 'preferences', 'settings', 'createdAt', 'updatedAt'
          ])
          && data.id == quizId
          && data.ownerId is string
          && data.schemaVersion is int
          && data.title is string
          && data.title.size() >= 1
          && data.title.size() <= 120
          && data.description is string
          && data.description.size() <= 500
          && data.iconId is string
          && data.iconId.size() >= 1
          && data.iconId.size() <= 40
          && validQuestionCount(data.questionCount)
          && validQuestionTypeCounts(data.questionTypeCounts, data.questionCount)
          && validQuizPreferences(data.preferences)
          && validQuizSettings(data.settings)
          && data.createdAt is timestamp
          && data.updatedAt is timestamp;
      }

      function counterWasIncremented() {
        let accountBefore = get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
        let accountAfter = getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data;
        return accountAfter.ownedQuizCount == accountBefore.ownedQuizCount + 1
          && accountAfter.ownedQuizCount <= 30
          && accountAfter.lastQuizMutationId == quizId;
      }

      function counterWasDecremented() {
        let accountBefore = get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
        let accountAfter = getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data;
        return accountAfter.ownedQuizCount == accountBefore.ownedQuizCount - 1
          && accountAfter.ownedQuizCount >= 0
          && accountAfter.lastQuizMutationId == quizId;
      }

      allow get: if canReadQuiz(quizId);
      allow list: if signedIn() && resource.data.ownerId == request.auth.uid;

      allow create: if signedIn()
        && request.resource.data.ownerId == request.auth.uid
        && validQuizSummary(request.resource.data)
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && counterWasIncremented()
        && existsAfter(/databases/$(database)/documents/quizzes/$(quizId)/content/current)
        && getAfter(/databases/$(database)/documents/quizzes/$(quizId)/content/current).data.questions.size()
          == request.resource.data.questionCount;

      allow update: if ownsQuiz(quizId)
        && request.resource.data.ownerId == resource.data.ownerId
        && request.resource.data.id == resource.data.id
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.updatedAt == request.time
        && validQuizSummary(request.resource.data)
        && existsAfter(/databases/$(database)/documents/quizzes/$(quizId)/content/current)
        && getAfter(/databases/$(database)/documents/quizzes/$(quizId)/content/current).data.questions.size()
          == request.resource.data.questionCount;

      allow delete: if ownsQuiz(quizId)
        && counterWasDecremented()
        && !existsAfter(/databases/$(database)/documents/quizzes/$(quizId)/content/current);

      match /content/{contentId} {
        function validQuizContent(data) {
          return contentId == 'current'
            && data.keys().hasOnly(['questions', 'updatedAt'])
            && data.questions is list
            && data.questions.size() <= 100
            && data.updatedAt is timestamp
            && data.updatedAt == request.time;
        }

        allow read: if canReadQuiz(quizId);

        allow create, update: if ownsQuizAfter(quizId)
          && validQuizContent(request.resource.data)
          && getAfter(/databases/$(database)/documents/quizzes/$(quizId)).data.questionCount
            == request.resource.data.questions.size();

        allow delete: if ownsQuiz(quizId)
          && !existsAfter(/databases/$(database)/documents/quizzes/$(quizId));
      }
    }

    match /quizShares/{shareId} {
      function validShare(data) {
        return data.keys().hasOnly([
            'quizId', 'ownerId', 'recipientId', 'friendshipId', 'createdAt'
          ])
          && data.quizId is string
          && data.ownerId is string
          && data.recipientId is string
          && data.friendshipId is string
          && data.createdAt is timestamp;
      }

      function friendshipAllowsShare(data) {
        let friendship = get(/databases/$(database)/documents/friendships/$(data.friendshipId)).data;
        return friendship.members is list
          && friendship.members.size() == 2
          && data.ownerId in friendship.members
          && data.recipientId in friendship.members;
      }

      allow read: if signedIn()
        && (resource.data.ownerId == request.auth.uid || resource.data.recipientId == request.auth.uid);

      allow create: if signedIn()
        && validShare(request.resource.data)
        && shareId == request.resource.data.quizId + '_' + request.resource.data.recipientId
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.recipientId != request.auth.uid
        && ownsQuiz(request.resource.data.quizId)
        && exists(/databases/$(database)/documents/friendships/$(request.resource.data.friendshipId))
        && friendshipAllowsShare(request.resource.data)
        && request.resource.data.createdAt == request.time;

      allow update: if false;
      allow delete: if signedIn()
        && (resource.data.ownerId == request.auth.uid || resource.data.recipientId == request.auth.uid);
    }

    match /friendRequests/{requestId} {
      function validFriendRequest(data) {
        return data.keys().hasOnly([
            'senderId', 'recipientId', 'status', 'createdAt', 'updatedAt'
          ])
          && data.senderId is string
          && data.recipientId is string
          && data.senderId != data.recipientId
          && data.status in ['pending', 'accepted', 'declined']
          && data.createdAt is timestamp
          && data.updatedAt is timestamp;
      }

      allow read: if signedIn()
        && (resource.data.senderId == request.auth.uid || resource.data.recipientId == request.auth.uid);

      allow create: if signedIn()
        && validFriendRequest(request.resource.data)
        && request.resource.data.senderId == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && exists(/databases/$(database)/documents/profiles/$(request.resource.data.recipientId));

      allow update: if signedIn()
        && validFriendRequest(request.resource.data)
        && request.resource.data.senderId == resource.data.senderId
        && request.resource.data.recipientId == resource.data.recipientId
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.updatedAt == request.time
        && (
          (
            resource.data.recipientId == request.auth.uid
            && resource.data.status == 'pending'
            && request.resource.data.status in ['accepted', 'declined']
          )
          || (
            resource.data.senderId == request.auth.uid
            && resource.data.status == 'declined'
            && request.resource.data.status == 'pending'
          )
        );

      allow delete: if signedIn()
        && (resource.data.senderId == request.auth.uid || resource.data.recipientId == request.auth.uid);
    }

    match /friendships/{friendshipId} {
      function validAcceptedFriendship(data) {
        let friendRequest = getAfter(
          /databases/$(database)/documents/friendRequests/$(data.requestId)
        ).data;
        return friendRequest.status == 'accepted'
          && friendRequest.senderId in data.members
          && friendRequest.recipientId in data.members;
      }

      allow read: if signedIn() && request.auth.uid in resource.data.members;

      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['members', 'requestId', 'createdAt', 'updatedAt'])
        && request.resource.data.members is list
        && request.resource.data.members.size() == 2
        && request.auth.uid in request.resource.data.members
        && request.resource.data.requestId is string
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && existsAfter(/databases/$(database)/documents/friendRequests/$(request.resource.data.requestId))
        && validAcceptedFriendship(request.resource.data);

      allow update: if false;
      allow delete: if signedIn() && request.auth.uid in resource.data.members;
    }

    match /quizProgress/{progressId} {
      function validProgress(data) {
        return data.keys().hasOnly([
            'userId', 'quizId', 'attempts', 'bestScore', 'lastPlayedAt', 'updatedAt'
          ])
          && data.userId is string
          && data.quizId is string
          && data.attempts is int
          && data.attempts >= 0
          && (data.bestScore == null || (data.bestScore is number && data.bestScore >= 0 && data.bestScore <= 100))
          && (data.lastPlayedAt == null || data.lastPlayedAt is timestamp)
          && data.updatedAt is timestamp;
      }

      allow get: if signedIn() && progressId.matches('^' + request.auth.uid + '_.*$');
      allow list: if signedIn() && resource.data.userId == request.auth.uid;

      allow create: if signedIn()
        && validProgress(request.resource.data)
        && progressId == request.auth.uid + '_' + request.resource.data.quizId
        && request.resource.data.userId == request.auth.uid
        && canReadQuiz(request.resource.data.quizId)
        && request.resource.data.updatedAt == request.time;

      allow update: if signedIn()
        && resource.data.userId == request.auth.uid
        && validProgress(request.resource.data)
        && request.resource.data.userId == resource.data.userId
        && request.resource.data.quizId == resource.data.quizId
        && canReadQuiz(request.resource.data.quizId)
        && request.resource.data.updatedAt == request.time;

      allow delete: if signedIn() && resource.data.userId == request.auth.uid;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
